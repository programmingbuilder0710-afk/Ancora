{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "DEMO_MODEL": "nvidia/nemotron-3.5-super-vl:free",
    "DEMO_UPSTREAM": "https://openrouter.ai/api/v1",
    "PIPEDREAM_ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": "https://doer.jaysinghcool1.workers.dev"
  },
  "ratelimits": [
    { "name": "DEMO_USER_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "DEMO_IP_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  // Request URLs contain bearer identities and private subscription URLs.
  "observability": { "enabled": false }
}
