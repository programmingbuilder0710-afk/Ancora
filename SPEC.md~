## 3. Data Model (SQLite)

```sql
CREATE TABLE goals (
  id              TEXT PRIMARY KEY,          -- client UUID
  parent_goal_id  TEXT REFERENCES goals(id), -- optional long-term goal grouping; NULL = short-term
  title           TEXT NOT NULL,
  description     TEXT NOT NULL DEFAULT '',
  priority        TEXT NOT NULL CHECK (priority IN ('P1','P2','P3')),
  target_date     TEXT NOT NULL,             -- ISO 8601 date, goal-level deadline
  status          TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active','archived')),
  created_at      TEXT NOT NULL
);

CREATE TABLE tasks (
  id               TEXT PRIMARY KEY,         -- client UUID (remapped from LLM task_id)
  goal_id          TEXT NOT NULL REFERENCES goals(id),
  title            TEXT NOT NULL,
  duration_minutes INTEGER NOT NULL,
  recommended_day  TEXT,                      -- LLM-assigned ISO date (input to slotter)
  pinned_deadline  TEXT,                      -- optional user-pinned latest acceptable day
  prerequisite_ids TEXT NOT NULL DEFAULT '[]', -- JSON array of task UUIDs
  scheduled_start  TEXT,                      -- ISO 8601 local datetime; slotter-owned
  scheduled_end    TEXT,
  status           TEXT NOT NULL DEFAULT 'pending'
                   CHECK (status IN ('pending','completed','skipped')),
  adjusted         INTEGER NOT NULL DEFAULT 0, -- slotter moved day or compressed duration
  skip_count       INTEGER NOT NULL DEFAULT 0,
  device_event_id  TEXT,                     -- event in "My Plan" calendar
  created_at       TEXT NOT NULL
);

CREATE TABLE documents (
  id             TEXT PRIMARY KEY,
  goal_id        TEXT NOT NULL REFERENCES goals(id),
  filename       TEXT NOT NULL,
  extracted_text TEXT NOT NULL               -- stored once; re-decompose reuses it
);

CREATE TABLE busy_blocks (
  id     TEXT PRIMARY KEY,
  source TEXT NOT NULL,                     -- imported file name
  start  TEXT NOT NULL,                     -- ISO 8601 local datetime
  end    TEXT NOT NULL
);

CREATE TABLE user_preferences (
  id             INTEGER PRIMARY KEY CHECK (id = 1),   -- singleton row
  work_start     TEXT NOT NULL,             -- 'HH:mm' local
  work_end       TEXT NOT NULL,
  buffer_minutes INTEGER NOT NULL DEFAULT 10,
  active_days    TEXT NOT NULL DEFAULT '["mon","tue","wed","thu","fri"]',
  timezone       TEXT NOT NULL,             -- IANA zone captured at setup
  plan_calendar_id TEXT                    -- device_calendar id of "My Plan"
);

CREATE TABLE provider_config (
  id        INTEGER PRIMARY KEY CHECK (id = 1),
  mode      TEXT NOT NULL DEFAULT 'demo' CHECK (mode IN ('demo','byok')),
  preset    TEXT,                           -- 'openai'|'anthropic'|'gemini'|'openrouter'|'custom'
  base_url  TEXT,                           -- required when preset = 'custom'
  model     TEXT
  -- API key is NOT stored here; it lives in flutter_secure_storage, keyed by preset.
);
```

**Notes**
- Free-form goal intake (no forced scaffold). Long-term goals are optional grouping rows; decomposition operates only on goals with a `target_date`.
- `documents.extracted_text` persists so regeneration never re-parses files.
- Busy blocks are read-path only: inputs to the slotter, never modified by it.

